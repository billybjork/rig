#!/usr/bin/env bash
# rig's gate runner, run in a project checkout with a .gate.json (rig's
# gate/README.md):
#
#   gate check [tier]           the split gate on HEAD, a fresh exe.dev VM per part
#   gate run <command...>       the workbench: a command on the working tree, on its own exe.dev VM
#   gate keys <rev>             what a golden VM made at <rev> holds: the stamp, each warm cache's key
#   gate golden <vm>            set a golden exe.dev VM (<vm>.exe.xyz) up and warm its caches
#   gate times                  rewrite the suite's partition weights
#   gate stamp [rev]            HEAD's (or rev's) provision stamp
#   gate self-check             the runner's own gate
#
# Nothing here takes a lock: each part, and each run, leases its own VM
# from rigd's Fleet, and a ship's gate leases ahead of a session's.
set -euo pipefail
gate=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

case "${1:-}" in
  self-check) cd "$gate" && unset MIX_ENV && exec mix check ;;
  "" | -h | --help) sed -n '2,15p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2; exit 64 ;;
esac

top=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "gate: run it in a project checkout" >&2; exit 2; }
config=$top/.gate.json
[ -f "$config" ] || { echo "gate: $config is missing" >&2; exit 2; }

# rig's toolchain (gate/.tool-versions), not the project's: the Elixir
# side runs from here, and $GATE_CWD names the checkout.
cd "$gate"
unset MIX_ENV
mix compile --no-deps-check >&2

# A gate stopped from outside (a closed terminal, the worker's timeout)
# ends the parts it launched, which would otherwise run on until Fleet
# removes their VMs. The runner lists each part it launches in
# $GATE_PARTS_FILE as "<vm> <id>"; an id is word characters, dots and
# dashes, so it needs no quoting.
parts=$(mktemp "${TMPDIR:-/tmp}/gate-parts.XXXXXX")
GATE_CWD=$top GATE_PARTS_FILE=$parts mix run --no-compile --no-deps-check --no-start \
  -e 'Gate.CLI.main(System.argv())' -- "$@" &
pid=$!
stop() {
  trap '' TERM INT HUP
  kill -TERM "$pid" 2>/dev/null
  wait "$pid" 2>/dev/null
  local end='p=$(cat ~/parts/"$1"/job.pid 2>/dev/null) && kill -KILL -- "-$p" 2>/dev/null; true'
  while read -r vm id; do
    echo "gate: ending $id on $vm" >&2
    "$gate/libexec/deadline" 30 --in <(printf '%s\n' "$end") "${GATE_SSH:-ssh}" -o BatchMode=yes \
      -o ConnectTimeout=20 -o UserKnownHostsFile="$gate/exe/known_hosts" -o StrictHostKeyChecking=yes \
      "$vm" "su - gate -c 'bash -s -- $id'" >/dev/null 2>&1 &
  done <"$parts"
  wait
  rm -f "$parts"
  exit "$1"
}
trap 'stop 143' TERM
trap 'stop 130' INT
trap 'stop 129' HUP
trap 'stop 142' ALRM
status=0
wait "$pid" || status=$?
rm -f "$parts"
exit "$status"
