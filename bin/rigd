#!/usr/bin/env bash
# rigd, the daemon that keeps the Mac awake while work runs, pushes when
# Billy is away, marks tabs, and leases the gate's VMs (rigd/README.md).
#
#   rigd install     build the release, drain Fleet, install the LaunchAgent, (re)start it
#   rigd status      what it sees: what runs, presence, keep-awake
#   rigd fleet       the gate's exe.dev VMs: the golden, its keys, the leases
#   rigd heavy       heavy local jobs: who holds a slot, who waits, what was demoted
#   rigd log         follow its log
#   rigd restart     restart it under launchd
#   rigd sudoers     install the pmset rule lid-closed keep-awake needs (asks for a password)
#   rigd uninstall   stop it and remove the LaunchAgent
set -euo pipefail

rig=$(cd "$(dirname "$0")/.." && pwd)
label=com.billy.rigd
plist=$HOME/Library/LaunchAgents/$label.plist
domain=gui/$(id -u)
status=$HOME/Library/Caches/rigd/status.json

main() {
  case "${1:-}" in
    install)
      (cd "$rig/rigd" && MIX_ENV=prod mix release --overwrite --quiet)
      drain
      launchctl bootout "$domain/$label" 2>/dev/null || true
      # bootout returns before the job is gone; bootstrapping it sooner fails.
      for _ in $(seq 50); do launchctl print "$domain/$label" >/dev/null 2>&1 || break; sleep 0.2; done
      cp "$rig/launchd/$label.plist" "$plist"
      launchctl bootstrap "$domain" "$plist"
      echo "rigd: running (log: ~/Library/Logs/rigd.log)"
      ;;
    status)
      [ -f "$status" ] || { echo "rigd: no status yet ($status)"; exit 1; }
      pid=$(jq -r .pid "$status")
      kill -0 "$pid" 2>/dev/null || echo "rigd: not running (status below is from pid $pid)"
      jq -r '
        "running:   \(.activity.running | if length == 0 then "nothing" else join("\n           ") end)",
        "agents:    \(.activity.agents | join("\n           "))",
        "presence:  \(if .presence.away then "away" else "present" end); lid \(if .presence.lid_closed then "closed" else "open" end); battery \(.presence.battery)%\(if .presence.ac then " on AC" else "" end); thermal \(if .presence.thermal_ok then "ok" else "pressure" end)",
        "awake:     \(if .awake.holding then "holding" else "not holding" end); disablesleep \(if .awake.sleep_disabled then "set" else "clear" end) (\(.awake.why))"' "$status"
      ;;
    fleet)
      # Fleet's socket answers one JSON line per message (Rigd.Fleet.Socket).
      python3 - <<'PY'
import json, os, socket, sys
s = socket.socket(socket.AF_UNIX)
s.settimeout(30)
try:
    s.connect(os.environ.get("GATE_FLEET_SOCKET") or os.path.expanduser("~/Library/Caches/rigd/fleet.sock"))
except OSError as e:
    sys.exit(f"rigd: Fleet does not answer ({e})")
s.sendall(b'{"status": {}}\n')
b = b""
while not b.endswith(b"\n"):
    c = s.recv(65536)
    if not c:
        break
    b += c
d = json.loads(b)
e = d.get("exe")
if not e:
    print("exe.dev: no pool (gate/fleet.json has no \"exe\")")
if e:
    print(f"exe.dev: golden {e['golden'] or 'none'}" + (f", making {e['refresh']}" if e["refresh"] else "") + f"; waiting {e['waiting']}")
    current = "  ".join(f"{k} {v}" for k, v in sorted(e["keys"].items()))
    print(f"golden:  {current or 'keys unknown'}")
    if e["target"] and e["target"] != e["keys"]:
        print("main:    " + "  ".join(f"{k} {v}" for k, v in sorted(e["target"].items())))
    if e.get("behind"):
        print(f"behind:  {e['behind']} Elixir sources of main's since the golden")
    if e["why"]:
        print(f"last:    {e['why']}")
    for name, v in sorted(e["leases"].items()):
        print(f"{name:30} {v['status']:9} {v['project']}{' (8 vCPU)' if v['big'] else ''}")
PY
      ;;
    heavy)
      # Heavy's socket (rigd/lib/rigd/heavy.ex), one JSON line per message.
      python3 - <<'PY'
import json, os, socket, sys, time
s = socket.socket(socket.AF_UNIX)
s.settimeout(30)
try:
    s.connect(os.path.expanduser("~/Library/Caches/rigd/heavy.sock"))
except OSError as e:
    sys.exit(f"rigd: Heavy does not answer ({e})")
s.sendall(b'{"status": {}}\n')
b = b""
while not b.endswith(b"\n"):
    c = s.recv(65536)
    if not c:
        break
    b += c
d = json.loads(b)
now = time.time()
print("slots:   " + "  ".join(f"{k} {v}" for k, v in sorted(d["slots"].items())))
for title, rows in (("holding", d["holders"]), ("waiting", d["waiting"])):
    for r in rows or [{}]:
        if not r:
            print(f"{title}: none")
            continue
        mins = int((now - r["since"]) / 60)
        print(f"{title}: {r['kind']:3} {r['label']} ({r.get('cwd') or '?'}, {mins} min)")
for r in d["demoted"]:
    print(f"demoted: {r.get('top') or r['cmd']} ({r.get('who', '?')}; job pid {r['root']}, {round(r['cpu'])}% CPU)")
PY
      ;;
    log) tail -n 40 -f "$HOME/Library/Logs/rigd.log" ;;
    restart) drain; launchctl kickstart -k "$domain/$label" ;;
    sudoers)
      visudo -cf "$rig/rigd/sudoers"
      sudo install -m 0440 -o root -g wheel "$rig/rigd/sudoers" /etc/sudoers.d/rigd
      sudo -n -l /usr/bin/pmset -a disablesleep 1 >/dev/null && echo "rigd: sudoers rule installed"
      ;;
    uninstall)
      launchctl bootout "$domain/$label" 2>/dev/null || true
      rm -f "$plist"
      ;;
    *) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 64 ;;
  esac
}

# Stops Fleet leasing and waits (20 min at most) until no VM is leased,
# so the restart drops no gate's part; gates waiting for a lease connect
# again to the new rigd (gate/lib/gate/lease.ex). A drain lapses a minute
# after its last renewal, so an install stopped here leaves Fleet leasing.
drain() {
  python3 - <<'PY'
import json, os, socket, sys, time

def ask(msg):
    s = socket.socket(socket.AF_UNIX)
    s.settimeout(30)
    s.connect(os.path.expanduser("~/Library/Caches/rigd/fleet.sock"))
    s.sendall((json.dumps(msg) + "\n").encode())
    b = b""
    while not b.endswith(b"\n"):
        c = s.recv(65536)
        if not c:
            break
        b += c
    s.close()
    return json.loads(b)

start = time.time()
said = None
while True:
    try:
        d = ask({"drain": {}})
        leased = d["draining"]["leased"]
    except (OSError, ValueError) as e:
        print(f"rigd: Fleet does not answer ({e}); restarting without a drain")
        break
    if not leased:
        print(f"rigd: drained in {int(time.time() - start)} s")
        break
    if time.time() - start > 20 * 60:
        print(f"rigd: still leased after 20 min, restarting anyway: {' '.join(leased)}")
        break
    if said is None or time.time() - said >= 60:
        print(f"rigd: draining, waiting for {' '.join(leased)}")
        said = time.time()
    time.sleep(3)
PY
}

main "$@"; exit
