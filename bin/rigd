#!/usr/bin/env bash
# rigd, the daemon that keeps the Mac awake while work runs, pushes when
# Billy is away, and marks tabs (~/dev/rig/rigd, README "rigd").
#
#   rigd install     build the release, install the LaunchAgent, (re)start it
#   rigd status      what it sees: what runs, presence, keep-awake
#   rigd log         follow its log
#   rigd restart     restart it under launchd
#   rigd sudoers     install the pmset rule lid-closed keep-awake needs (asks for a password)
#   rigd uninstall   stop it and remove the LaunchAgent
set -euo pipefail

rig=$(cd "$(dirname "$0")/.." && pwd)
label=com.billy.rigd
plist=$HOME/Library/LaunchAgents/$label.plist
domain=gui/$(id -u)
status=$HOME/Library/Caches/rigd/status.json

main() {
  case "${1:-}" in
    install)
      (cd "$rig/rigd" && MIX_ENV=prod mix release --overwrite --quiet)
      launchctl bootout "$domain/$label" 2>/dev/null || true
      cp "$rig/launchd/$label.plist" "$plist"
      launchctl bootstrap "$domain" "$plist"
      echo "rigd: running (log: ~/Library/Logs/rigd.log)"
      ;;
    status)
      [ -f "$status" ] || { echo "rigd: no status yet ($status)"; exit 1; }
      pid=$(jq -r .pid "$status")
      kill -0 "$pid" 2>/dev/null || echo "rigd: not running (status below is from pid $pid)"
      jq -r '
        "running:   \(.activity.running | if length == 0 then "nothing" else join("\n           ") end)",
        "agents:    \(.activity.agents | join("\n           "))",
        "presence:  \(if .presence.away then "away" else "present" end); lid \(if .presence.lid_closed then "closed" else "open" end); battery \(.presence.battery)%\(if .presence.ac then " on AC" else "" end); thermal \(if .presence.thermal_ok then "ok" else "pressure" end)",
        "awake:     \(if .awake.holding then "holding" else "not holding" end); disablesleep \(if .awake.sleep_disabled then "set" else "clear" end) (\(.awake.why))"' "$status"
      ;;
    log) tail -n 40 -f "$HOME/Library/Logs/rigd.log" ;;
    restart) launchctl kickstart -k "$domain/$label" ;;
    sudoers)
      visudo -cf "$rig/rigd/sudoers"
      sudo install -m 0440 -o root -g wheel "$rig/rigd/sudoers" /etc/sudoers.d/rigd
      sudo -n -l /usr/bin/pmset -a disablesleep 1 >/dev/null && echo "rigd: sudoers rule installed"
      ;;
    uninstall)
      launchctl bootout "$domain/$label" 2>/dev/null || true
      rm -f "$plist"
      ;;
    *) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 64 ;;
  esac
}

main "$@"; exit
